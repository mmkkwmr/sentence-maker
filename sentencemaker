import sys
import random

words = []

for line in sys.stdin:
    words += line.split()

if len(words) < 3 or len(words) > 5:
    print("単語は3〜5個で入力してください。", file=sys.stderr)
    sys.exit(1)

subject = words[0]
place = words[1]
action = words[2]

if len(words) == 3:
    patterns = [
        "{}は{}で{}をした。",
        "{}は{}で{}をする。",
        "{}は{}で{}をしている。",
        "{}は{}で{}をしていた。"
    ]

    selected_pattern = random.choice(patterns)

    sentence = selected_pattern.format(
        subject, place, action
    )

if len(words) == 4:
    patterns = [
        "{}は{}で{}をした。",
        "{}は{}で{}をする。",
        "{}は{}で{}をしている。",
        "{}は{}で{}をしていた。"
    ]

    selected_pattern = random.choice(patterns)

    sentence = selected_pattern.format(
        subject, place, action
    )

    extra_patterns = [
        "{}について考えていた。",
        "{}のことを考えていた。",
        "{}も気になっていた。",
        "{}について話していた。"
    ]

    extra_pattern = random.choice(extra_patterns)

    sentence += extra_pattern.format(words[3])

if len(words) == 5:
    patterns = [
        "{}は{}で{}をした。",
        "{}は{}で{}をする。",
        "{}は{}で{}をしている。",
        "{}は{}で{}をしていた。"
    ]

    selected_pattern = random.choice(patterns)

    sentence = selected_pattern.format(
        subject, place, action
    )

    extra_patterns = [
        "{}と{}を持っていた。",
        "{}と{}を見ていた。",
        "{}と{}を使っていた。",
        "{}と{}を調べていた。"
    ]

    extra_pattern = random.choice(extra_patterns)

    sentence += extra_pattern.format(words[3], words[4])

print(sentence)
